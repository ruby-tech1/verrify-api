# Copy values into the Compose service Environment tab in Dokploy.
# Example values only; preserve the existing production credentials.
# Infrastructure values PORT, APP_PROFILE, NODE_ENV, DB_HOST, DB_PORT,
# DB_TYPE and LOG_FILE_PATH are fixed in the Compose template.

FRONTEND_HOST=https://your-frontend-domain.example
ORIGIN=https://your-frontend-domain.example

DB_USERNAME=replace-with-existing-value
DB_PASSWORD=replace-with-existing-value
DB_NAME=verrify
DB_SSL=false

RABBITMQ_USERNAME=replace-with-existing-value
RABBITMQ_PASSWORD=replace-with-existing-value
RABBITMQ_URI=amqp://replace-with-existing-value:replace-with-existing-value@rabbitmq:5672

EMAIL_PROVIDER=smtp
EMAIL_RESEND_API_KEY=
EMAIL_USERNAME=replace-with-existing-value
EMAIL_PASSWORD=replace-with-existing-value
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_REQUIRE_TLS=true
EMAIL_SENDER=noreply@example.com
ADMIN_EMAIL=admin@example.com

JWT_SECRET=replace-with-existing-value
JWT_EXPIRE=15m
REFRESH_EXPIRE=24
VERIFICATION_EXPIRE=15


R2_ACCOUNT_ID=replace-with-existing-value
R2_ACCESS_KEY_ID=replace-with-existing-value
R2_SECRET_ACCESS_KEY=replace-with-existing-value
R2_PUBLIC_BUCKET=verrify-prod-public
R2_PRIVATE_BUCKET=verrify-prod-private
R2_PUBLIC_BASE_URL=https://files.example.com
R2_PRESIGNED_URL_TTL_SECONDS=1800

GOOGLE_CLIENT_EMAIL=replace-with-existing-value
GOOGLE_PRIVATE_KEY=replace-with-existing-value
GOOGLE_SHEET_ID=replace-with-existing-value
GOOGLE_SHEET_NAME=replace-with-existing-value

PAYSTACK_PUBLIC_KEY=replace-with-existing-value
PAYSTACK_SECRET_KEY=replace-with-existing-value
PAYSTACK_DOMAIN=live
PAYSTACK_TIMEOUT_MS=10000
